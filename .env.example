# Application Environment
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:3000

# Database Configuration (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=uplora
DB_PASSWORD=uplora_secret
DB_NAME=uplora_db

# Redis Cache & Queue
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT Authentication
JWT_SECRET=super-secret-uplora-jwt-token-key-change-in-production
JWT_EXPIRATION=7d
REFRESH_TOKEN_EXPIRATION=30d

# AI Providers Configuration
OPENAI_API_KEY=sk-proj-your-openai-api-key
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3
HUGGINGFACE_API_KEY=hf_your_huggingface_token

# Storage Configuration (Local / Cloudflare R2 / S3)
STORAGE_DRIVER=local
UPLOAD_DIR=./uploads
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=uplora-media

# Social Media API Keys (Optional)
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
