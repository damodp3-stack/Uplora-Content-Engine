{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "version": "3.0.0",
  "description": "Uplora Content Engine — Complete JSON Schema System",

  "schemas": {

    "Content": {
      "$id": "uplora://schemas/Content",
      "type": "object",
      "required": ["title", "body", "type"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "format": "uuid" },
        "title": {
          "type": "string",
          "minLength": 3,
          "maxLength": 500,
          "errorMessage": "Title must be 3-500 characters"
        },
        "slug": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "maxLength": 600
        },
        "excerpt": { "type": "string", "maxLength": 500 },
        "body": {
          "type": "object",
          "description": "TipTap JSON document",
          "required": ["type"],
          "properties": {
            "type": { "type": "string", "const": "doc" },
            "content": { "type": "array" }
          }
        },
        "plainText": { "type": "string" },
        "htmlContent": { "type": "string" },
        "type": {
          "type": "string",
          "enum": [
            "blog_post", "social_post", "newsletter",
            "video_script", "thread", "carousel",
            "ad_copy", "email", "press_release",
            "product_description", "custom"
          ],
          "errorMessage": "Invalid content type"
        },
        "status": {
          "type": "string",
          "enum": ["draft", "in_review", "approved", "scheduled", "published", "archived"],
          "default": "draft"
        },
        "workspaceId": { "type": "string", "format": "uuid" },
        "authorId": { "type": "string", "format": "uuid" },
        "tags": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 50,
            "pattern": "^[a-z0-9][a-z0-9-]*[a-z0-9]$|^[a-z0-9]$"
          },
          "maxItems": 20,
          "uniqueItems": true
        },
        "platforms": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "twitter", "linkedin", "instagram",
              "facebook", "youtube", "tiktok",
              "pinterest", "reddit", "medium",
              "dev_to", "wordpress"
            ]
          },
          "uniqueItems": true
        },
        "scheduledAt": {
          "type": "string",
          "format": "date-time"
        },
        "publishedAt": { "type": "string", "format": "date-time" },
        "featuredImage": { "type": "string", "format": "uri" },
        "mediaAttachments": {
          "type": "array",
          "items": { "type": "string", "format": "uuid" },
          "maxItems": 20
        },
        "currentVersion": {
          "type": "integer",
          "minimum": 1,
          "default": 1
        },
        "seo": { "$ref": "#/definitions/SEOData" },
        "aiMetadata": { "$ref": "#/definitions/AIMetadata" },
        "socialVariants": { "$ref": "#/definitions/SocialVariants" },
        "engagementData": { "$ref": "#/definitions/EngagementData" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "deletedAt": { "type": "string", "format": "date-time" }
      }
    },

    "User": {
      "$id": "uplora://schemas/User",
      "type": "object",
      "required": ["name", "email", "password"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "format": "uuid" },
        "name": {
          "type": "string",
          "minLength": 2,
          "maxLength": 100,
          "errorMessage": "Name must be 2-100 characters"
        },
        "email": {
          "type": "string",
          "format": "email",
          "maxLength": 255,
          "errorMessage": "Must be a valid email address"
        },
        "password": {
          "type": "string",
          "minLength": 8,
          "maxLength": 128,
          "errorMessage": "Password must be 8-128 characters"
        },
        "role": {
          "type": "string",
          "enum": ["super_admin", "admin", "editor", "viewer"],
          "default": "editor"
        },
        "avatar": { "type": "string", "format": "uri" },
        "isEmailVerified": { "type": "boolean", "default": false },
        "isActive": { "type": "boolean", "default": true },
        "activeWorkspaceId": { "type": "string", "format": "uuid" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      }
    },

    "Workspace": {
      "$id": "uplora://schemas/Workspace",
      "type": "object",
      "required": ["name", "ownerId"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "format": "uuid" },
        "name": { "type": "string", "minLength": 2, "maxLength": 100 },
        "slug": { "type": "string", "maxLength": 100 },
        "description": { "type": "string", "maxLength": 500 },
        "ownerId": { "type": "string", "format": "uuid" },
        "plan": {
          "type": "string",
          "enum": ["free", "pro", "team", "enterprise"],
          "default": "free"
        },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },

    "AIRequest": {
      "$id": "uplora://schemas/AIRequest",
      "type": "object",
      "required": ["prompt", "type"],
      "additionalProperties": false,
      "properties": {
        "prompt": { "type": "string", "minLength": 5, "maxLength": 5000 },
        "type": {
          "type": "string",
          "enum": [
            "blog_post", "twitter_post", "twitter_thread",
            "linkedin_post", "instagram_caption", "facebook_post",
            "tiktok_script", "email_newsletter", "email_cold_outreach",
            "video_script_youtube", "ad_copy_google", "ad_copy_social",
            "content_repurpose", "seo_analysis", "title_generator",
            "hashtag_generator", "content_brief", "content_strategy"
          ]
        },
        "tone": { "type": "string", "default": "professional" },
        "length": { "type": "string", "default": "medium" },
        "language": { "type": "string", "default": "English" },
        "targetAudience": { "type": "string", "maxLength": 200 },
        "keywords": {
          "type": "array",
          "items": { "type": "string", "maxLength": 100 },
          "maxItems": 10
        },
        "provider": {
          "type": "string",
          "enum": ["ollama", "huggingface", "openai"]
        }
      }
    },

    "APIResponse": {
      "$id": "uplora://schemas/APIResponse",
      "type": "object",
      "required": ["success"],
      "properties": {
        "success": { "type": "boolean" },
        "data": {},
        "message": { "type": "string" },
        "error": {
          "type": "object",
          "required": ["code", "message"],
          "properties": {
            "code": { "type": "string" },
            "message": { "type": "string" }
          }
        }
      }
    }
  },

  "definitions": {
    "SEOData": {
      "type": "object",
      "properties": {
        "metaTitle": { "type": "string", "maxLength": 60 },
        "metaDescription": { "type": "string", "maxLength": 160 },
        "focusKeyword": { "type": "string" },
        "seoScore": { "type": "integer", "minimum": 0, "maximum": 100 }
      }
    },
    "AIMetadata": {
      "type": "object",
      "properties": {
        "generatedBy": { "type": "string" },
        "model": { "type": "string" },
        "prompt": { "type": "string" },
        "tokensUsed": { "type": "integer" }
      }
    },
    "SocialVariants": {
      "type": "object",
      "properties": {
        "twitter": { "type": "object" },
        "linkedin": { "type": "object" },
        "instagram": { "type": "object" },
        "facebook": { "type": "object" }
      }
    },
    "EngagementData": {
      "type": "object",
      "properties": {
        "viewCount": { "type": "integer" },
        "shareCount": { "type": "integer" },
        "likes": { "type": "integer" }
      }
    }
  }
}
